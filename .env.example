NODE_ENV=development
PORT=3000

DATA_MODE=local
DATABASE_PATH=./data/automarket.db
UPLOADS_DIR=./data/uploads/listings

# Demo fallback is explicit. Production must not silently accept fake Telegram users.
ALLOW_DEMO_MODE=true
PAYMENT_PROVIDER=demo
ALLOW_DEMO_PAYMENTS=true
ADMIN_TOKEN=automarket-demo
TELEGRAM_BOT_TOKEN=

APP_URL=http://localhost:5173
TZ=Europe/Moscow

BUSINESS_NAME=AutoMarket Demo
APP_TITLE=AutoMarket Demo
APP_DESCRIPTION=Автомобильная доска объявлений в Telegram.
BRAND_ACCENT=#2563EB
CURRENCY=RUB
CURRENCY_SYMBOL=₽

FEATURE_DEMO_TOUR=false
FEATURE_DEMO_ADMIN_PREVIEW=true
