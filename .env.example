NODE_ENV=development
PORT=3000

DATA_MODE=local
DATABASE_PATH=./data/realestate.db

# Demo fallback is explicit. Production must not silently accept fake Telegram users.
ALLOW_DEMO_MODE=true
ADMIN_TOKEN=nord-estate-demo
TELEGRAM_BOT_TOKEN=

CRM_ADAPTER=local
PROPERTY_ADAPTER=local
EVENT_ADAPTER=local
EVENT_WEBHOOK_URL=

# Used only when CRM_ADAPTER=external / PROPERTY_ADAPTER=external.
# Without these, adapters return 501 CRM_NOT_CONFIGURED / PROPERTY_PROVIDER_NOT_CONFIGURED.
CRM_BASE_URL=
PROPERTY_PROVIDER_URL=

APP_URL=http://localhost:5173
TZ=Europe/Moscow

BUSINESS_NAME=Норд Эстейт
APP_TITLE=Норд Эстейт
APP_DESCRIPTION=Квартиры под ваш сценарий жизни — не каталог, а квалифицированный подбор.
BRAND_ACCENT=#C4A574
CURRENCY=RUB
CURRENCY_SYMBOL=₽

MORTGAGE_DEFAULT_RATE=16
MORTGAGE_DEFAULT_TERM_YEARS=20
MORTGAGE_DEFAULT_DOWN_PERCENT=20

FEATURE_DEMO_TOUR=true
FEATURE_DEMO_ADMIN_PREVIEW=true
